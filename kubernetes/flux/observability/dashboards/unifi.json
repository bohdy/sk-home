{
  "annotations": {
    "list": []
  },
  "description": "UniFi controller health, site inventory, topology, and bandwidth as reported by the unpoller.",
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "Poller-to-controller connectivity. 1 means the controller is reachable and returning data.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "unpoller_controller_up",
          "legendFormat": "{{source}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Controller health",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "Age of the poller's cached data in seconds. Higher values mean the poller is falling behind its refresh cycle.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 180
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "unpoller_prometheus_cache_age_seconds",
          "legendFormat": "cache age",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Cache age",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "Rate of cache refresh failures. Sustained failures indicate controller connectivity issues.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "rate(unpoller_prometheus_refresh_failures_total[5m])",
          "legendFormat": "failures/s",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Refresh failures",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "Per-site counts of users, access points, and stations from the poller's cached inventory.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "unpoller_site_users",
          "legendFormat": "{{site_name}} users",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "unpoller_site_aps",
          "legendFormat": "{{site_name}} APs",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "unpoller_site_stations",
          "legendFormat": "{{site_name}} stations",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Site inventory",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "Per-site transmit and receive bandwidth from the UniFi controller's traffic counters.",
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "unpoller_site_transmit_rate_bytes",
          "legendFormat": "{{site_name}} tx",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "unpoller_site_receive_rate_bytes",
          "legendFormat": "{{site_name}} rx",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Site bandwidth",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "Topology-level device and client counts, plus wired vs wireless connection split.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "unpoller_topology_devices_total",
          "legendFormat": "{{site_name}} devices",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "unpoller_topology_clients_total",
          "legendFormat": "{{site_name}} clients",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "unpoller_topology_connections_wired",
          "legendFormat": "{{site_name}} wired",
          "range": true,
          "refId": "C"
        },
        {
          "editorMode": "code",
          "expr": "unpoller_topology_connections_wireless",
          "legendFormat": "{{site_name}} wireless",
          "range": true,
          "refId": "D"
        }
      ],
      "title": "Topology",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 42,
  "tags": [
    "homelab",
    "unifi",
    "unpoller",
    "ubiquiti"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "UniFi Controller",
  "uid": "sk-unifi",
  "version": 1
}
