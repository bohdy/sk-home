{
  "annotations": {
    "list": []
  },
  "description": "WAN flow analytics backed by ClickHouse flow records collected from the MikroTik gateway.",
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "FlowClickHouseIaC"
      },
      "description": "Bytes per second across all flow records; buckets are fixed at one minute so the per-second rate is exact.",
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "format": 1,
          "rawSql": "SELECT toStartOfInterval(timestamp, INTERVAL 1 minute) AS time, sum(bytes) / 60 AS traffic FROM flows.flow WHERE $__timeFilter(timestamp) GROUP BY time ORDER BY time",
          "refId": "A"
        }
      ],
      "title": "WAN traffic",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "FlowClickHouseIaC"
      },
      "description": "Flow records received per second from the gateway.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "format": 1,
          "rawSql": "SELECT toStartOfInterval(timestamp, INTERVAL 1 minute) AS time, count() / 60 AS flows FROM flows.flow WHERE $__timeFilter(timestamp) GROUP BY time ORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Flows",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "FlowClickHouseIaC"
      },
      "description": "Traffic split by transport protocol.",
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "format": 1,
          "rawSql": "SELECT toStartOfInterval(timestamp, INTERVAL 1 minute) AS time, proto AS protocol, sum(bytes) / 60 AS traffic FROM flows.flow WHERE $__timeFilter(timestamp) GROUP BY time, protocol ORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Traffic by protocol",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "FlowClickHouseIaC"
      },
      "description": "Source addresses ordered by volume; on a WAN-only collector this shows remote peers and local hosts.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillWidth": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "bytes"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decbytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "packets"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "flows"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "id": 4,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "editorMode": "code",
          "format": 0,
          "rawSql": "SELECT src_addr AS source, sum(bytes) AS bytes, sum(packets) AS packets, count() AS flows FROM flows.flow WHERE $__timeFilter(timestamp) GROUP BY src_addr ORDER BY bytes DESC LIMIT 20",
          "refId": "A"
        }
      ],
      "title": "Top source addresses",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "FlowClickHouseIaC"
      },
      "description": "Destination ports ordered by volume; useful for spotting services the homelab reaches externally.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillWidth": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "bytes"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decbytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "flows"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "id": 5,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "editorMode": "code",
          "format": 0,
          "rawSql": "SELECT dst_port AS port, count() AS flows, sum(bytes) AS bytes FROM flows.flow WHERE $__timeFilter(timestamp) GROUP BY dst_port ORDER BY bytes DESC LIMIT 20",
          "refId": "A"
        }
      ],
      "title": "Top destination ports",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "FlowClickHouseIaC"
      },
      "description": "Traffic classified by which side of the WAN interface the source address belongs to.",
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "format": 1,
          "rawSql": "SELECT toStartOfInterval(timestamp, INTERVAL 1 minute) AS time, if(src_addr LIKE '10.%', 'lan-source', 'wan-source') AS direction, sum(bytes) / 60 AS traffic FROM flows.flow WHERE $__timeFilter(timestamp) GROUP BY time, direction ORDER BY time",
          "refId": "A"
        }
      ],
      "title": "LAN vs WAN sources",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "FlowClickHouseIaC"
      },
      "description": "Top source-to-destination IP pairs ranked by total bytes during the selected time range.",
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "source"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Source IP"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "destination"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Destination IP"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 15,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "id": 7,
      "options": {
        "color": "blue",
        "iteration": 7,
        "labelSize": 14,
        "monochrome": false,
        "nodeColor": "grey",
        "nodePadding": 18,
        "nodeWidth": 24,
        "valueField": "bytes"
      },
      "targets": [
        {
          "editorMode": "code",
          "format": 0,
          "rawSql": "SELECT src_addr AS source, dst_addr AS destination, sum(bytes) AS bytes FROM flows.flow WHERE $__timeFilter(timestamp) AND src_addr != '' AND dst_addr != '' GROUP BY src_addr, dst_addr ORDER BY bytes DESC LIMIT 20",
          "refId": "A"
        }
      ],
      "title": "Top IP pairs by bytes",
      "type": "netsage-sankey-panel"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "FlowClickHouseIaC"
      },
      "description": "Top source-to-destination IP pairs ranked by flow count during the selected time range.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "source"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Source IP"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "destination"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Destination IP"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 15,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "id": 8,
      "options": {
        "color": "blue",
        "iteration": 7,
        "labelSize": 14,
        "monochrome": false,
        "nodeColor": "grey",
        "nodePadding": 18,
        "nodeWidth": 24,
        "valueField": "flows"
      },
      "targets": [
        {
          "editorMode": "code",
          "format": 0,
          "rawSql": "SELECT src_addr AS source, dst_addr AS destination, count() AS flows FROM flows.flow WHERE $__timeFilter(timestamp) AND src_addr != '' AND dst_addr != '' GROUP BY src_addr, dst_addr ORDER BY flows DESC LIMIT 20",
          "refId": "A"
        }
      ],
      "title": "Top IP pairs by flow count",
      "type": "netsage-sankey-panel"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 42,
  "tags": [
    "homelab",
    "flows",
    "ipfix",
    "clickhouse"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Flow Analytics",
  "uid": "sk-flow",
  "version": 1
}
